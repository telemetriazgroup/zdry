# Odoo (S10). En S0–S9 el conector es noop y solo encola.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_ENABLED=false

SEED_DEMO=true
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
