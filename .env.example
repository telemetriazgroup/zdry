# ZDRY — copiar a .env (nunca commitear secretos)

POSTGRES_USER=zdry
POSTGRES_PASSWORD=zdry
POSTGRES_DB=zdry
DATABASE_URL=postgresql://zdry:zdry@db:5432/zdry

REDIS_URL=redis://redis:6379

