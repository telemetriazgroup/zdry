generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  gerente
  vendedor
  compras
  almacen
}

enum RiskGrade {
  A
  B
  C
  D
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role
  active           Boolean    @default(true)
  refreshTokenHash String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  auditLogs        AuditLog[]
}

model Depot {
  id           String      @id @default(uuid())
  name         String
  city         String
  address      String
  dailyRateTeu Decimal     @db.Decimal(12, 4)
  lat          Float?
  lng          Float?
  protected    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  containers   Container[]
}

model Container {
  iso                String              @id
  type               String
  cat                String
  status             String              @default("Pendiente de ingreso")
  year               Int?
  manufacturer       String              @default("—")
  depotId            String
  depot              Depot               @relation(fields: [depotId], references: [id])
  lado               String?
  ruma               Int?
  columna            Int?
  nivel              Int?
  tareKg             Int                 @default(0)
  mgwKg              Int                 @default(0)
  payloadKg          Int                 @default(0)
  color              String              @default("—")
  inspectionNotes    String              @default("")
  cbm                Decimal?            @db.Decimal(8, 2)
  gateIn             Boolean             @default(false)
  gateOut            Boolean             @default(false)
  video360Key        String?
  video360Mime       String?
  ownerCustomerId    String?
  ownerCustomer      Customer?           @relation(fields: [ownerCustomerId], references: [id])
  storageDiscountPct Decimal             @default(0) @db.Decimal(5, 2)
  intakeType         String              @default("compra")
  invoicePending     Boolean             @default(false)
  physicallyReceived Boolean             @default(false)
  isoException       Boolean             @default(false)
  isoExceptionReason String?
  fobCif             Decimal             @db.Decimal(12, 2)
  priceList          Decimal?            @db.Decimal(12, 2)
  priceMin           Decimal?            @db.Decimal(12, 2)
  bl                 String              @default("")
  manifest           String              @default("")
  damNumber          String?
  nationalizedAt     DateTime?
  purchaseInvoiceId  String?
  purchaseInvoice    PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  history            ContainerHistory[]
  photos             InspectionPhoto[]
  positions          ContainerPosition[]

  @@index([depotId])
  @@index([status])
  @@index([damNumber])
  @@index([depotId, lado])
}

model ContainerHistory {
  id          String    @id @default(uuid())
  iso         String
  container   Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  type        String
  detail      String
  createdAt   DateTime  @default(now())

  @@index([iso, createdAt])
}

model PurchaseInvoice {
  id           String             @id @default(uuid())
  number       String
  providerName String
  incoterm     String
  logistics    String
  amount       Decimal            @db.Decimal(12, 2)
  extras       Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        PurchaseInvoiceLine[]
  containers   Container[]
  pendingExtras PendingExtraCost[]
  documents    PurchaseDocument[]

  @@index([number])
}

model PurchaseDocument {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  kind              String
  originalName      String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  createdAt         DateTime        @default(now())

  @@index([purchaseInvoiceId])
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  invoiceId         String
  invoice           PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  iso               String
  type              String
  cat               String
  year              Int?
  manufacturer      String          @default("—")
  price             Decimal         @db.Decimal(12, 2)
  bl                String          @default("")
  manifest          String          @default("")
  isoException      Boolean         @default(false)
}

model PendingExtraCost {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  serviceKey        String
  serviceLabel      String
  suggestedProvider String          @default("")
  isos              String[]
  status            String          @default("pending")
  createdAt         DateTime        @default(now())

  @@index([status])
}

model ContainerType {
  code      String  @id
  label     String
  dims      String
  color     String
  protected Boolean @default(false)
}

model Category {
  code      String  @id
  label     String
  color     String
  protected Boolean @default(false)
}

model Customer {
  id               String      @id @default(uuid())
  rucDni           String
  companyName      String
  email            String
  phone            String
  risk             RiskGrade   @default(B)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  ownedContainers  Container[]
}

model InspectionPhoto {
  id           String    @id @default(uuid())
  iso          String
  container    Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  slot         Int
  storageKey   String
  mimeType     String
  originalName String
  sizeBytes    Int
  createdAt    DateTime  @default(now())

  @@unique([iso, slot])
}

model ContainerPosition {
  id        String    @id @default(uuid())
  iso       String
  container Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  depotId   String
  lado      String
  ruma      Int
  columna   Int
  nivel     Int
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([iso, createdAt])
}

model AppSetting {
  key   String @id
  value Json
}

model Provider {
  id        String   @id @default(uuid())
  name      String
  type      String
  rate      Decimal  @db.Decimal(12, 2)
  unit      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
