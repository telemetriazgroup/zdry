generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  gerente
  vendedor
  compras
  almacen
}

enum RiskGrade {
  A
  B
  C
  D
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role
  active           Boolean    @default(true)
  refreshTokenHash String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  auditLogs        AuditLog[]
}

model Depot {
  id           String   @id @default(uuid())
  name         String
  city         String
  address      String
  dailyRateTeu Decimal  @db.Decimal(12, 4)
  lat          Float?
  lng          Float?
  protected    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContainerType {
  code      String  @id
  label     String
  dims      String
  color     String
  protected Boolean @default(false)
}

model Category {
  code      String  @id
  label     String
  color     String
  protected Boolean @default(false)
}

model Customer {
  id          String     @id @default(uuid())
  rucDni      String
  companyName String
  email       String
  phone       String
  risk        RiskGrade  @default(B)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Provider {
  id        String   @id @default(uuid())
  name      String
  type      String
  rate      Decimal  @db.Decimal(12, 2)
  unit      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
