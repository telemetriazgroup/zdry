generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  gerente
  vendedor
  compras
  coordinador
  almacen
  cliente
}

enum RiskGrade {
  A
  B
  C
  D
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role
  active           Boolean    @default(true)
  refreshTokenHash String?
  customerId       String?
  customer         Customer?  @relation(fields: [customerId], references: [id])
  demo             Boolean    @default(false)
  avatarKey        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  auditLogs        AuditLog[]
  quotesSold       Quote[]    @relation("QuoteVendor")

  @@index([demo])
}

model Depot {
  id           String      @id @default(uuid())
  name         String
  city         String
  address      String
  dailyRateTeu Decimal     @db.Decimal(12, 4)
  lat          Float?
  lng          Float?
  protected    Boolean     @default(false)
  archivedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  containers   Container[]
}

model Container {
  iso                String              @id
  type               String
  cat                String
  status             String              @default("Pendiente de ingreso")
  year               Int?
  manufacturer       String              @default("—")
  depotId            String
  depot              Depot               @relation(fields: [depotId], references: [id])
  lado               String?
  ruma               Int?
  columna            Int?
  nivel              Int?
  tareKg             Int                 @default(0)
  mgwKg              Int                 @default(0)
  payloadKg          Int                 @default(0)
  color              String              @default("—")
  inspectionNotes    String              @default("")
  cbm                Decimal?            @db.Decimal(8, 2)
  gateIn             Boolean             @default(false)
  gateOut            Boolean             @default(false)
  video360Key        String?
  video360Mime       String?
  mediaStatus        String              @default("pendiente")
  mediaApprovedBy    String?
  mediaApprovedAt    DateTime?
  mediaReviewNote    String?
  ownerCustomerId    String?
  ownerCustomer      Customer?           @relation("OwnedContainers", fields: [ownerCustomerId], references: [id])
  storageDiscountPct Decimal             @default(0) @db.Decimal(5, 2)
  commercialStatus   String              @default("disponible")
  physicalStatus     String              @default("en_transito_ingreso")
  reservedBy         String?
  reservationExpiry  DateTime?
  reservedQuoteId    String?
  showPriceOverride  Boolean?
  priceSource        String?
  priceAdjustedAt    DateTime?
  priceAdjustedByName String?
  intakeType         String              @default("compra")
  invoicePending     Boolean             @default(false)
  physicallyReceived Boolean             @default(false)
  isoException       Boolean             @default(false)
  isoExceptionReason String?
  fobCif             Decimal             @db.Decimal(12, 2)
  priceList          Decimal?            @db.Decimal(12, 2)
  priceMin           Decimal?            @db.Decimal(12, 2)
  bl                 String              @default("")
  manifest           String              @default("")
  damNumber          String?
  nationalizedAt     DateTime?
  purchaseInvoiceId  String?
  purchaseInvoice    PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id])
  demo               Boolean             @default(false)
  registeredById     String?
  registeredByName   String?
  archivedAt         DateTime?
  archiveReason      String?
  archivedById       String?
  archivedByName     String?
  intakeOrigin       String              @default("manual")
  odooLotId          Int?
  odooLocation       String?
  odooDua            String?
  odooPoName         String?
  odooPoId           Int?
  odooVendorName     String?
  odooBillName       String?
  odooUnitPrice      Decimal?            @db.Decimal(12, 2)
  originCountry      String?
  conditionFloor     String?
  conditionRoof      String?
  conditionDoors     String?
  conditionPaint     String?
  conditionWalls     String?
  roofHole           Boolean?
  material           String?
  campoEnabledAt     DateTime?
  campoEnabledByName String?
  odooSource              Json?
  fieldRegularizedAt      DateTime?
  fieldRegularizedByName  String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  history                 ContainerHistory[]
  photos                  InspectionPhoto[]
  positions               ContainerPosition[]
  fieldCaptures           FieldCapture[]
  depotCosts              DepotCostEntry[]
  documents               ContainerDocument[]
  gateVisits              GateVisit[]
  priceChanges            ContainerPriceChange[]

  @@index([depotId])
  @@index([odooLotId])
  @@index([intakeOrigin])
  @@index([status])
  @@index([damNumber])
  @@index([depotId, lado])
  @@index([commercialStatus])
  @@index([mediaStatus])
  @@index([demo])
  @@index([archivedAt])
  @@index([fieldRegularizedAt])
  @@index([mediaApprovedAt])
  @@index([campoEnabledAt])
}

model ContainerPriceChange {
  id             String    @id @default(uuid())
  iso            String
  container      Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  priceList      Decimal   @db.Decimal(12, 2)
  priceMin       Decimal   @db.Decimal(12, 2)
  showPrice      Boolean
  source         String
  note           String    @default("")
  changedById    String?
  changedByName  String
  createdAt      DateTime  @default(now())

  @@index([iso, createdAt])
}

model ContainerHistory {
  id          String    @id @default(uuid())
  iso         String
  container   Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  type        String
  detail      String
  createdAt   DateTime  @default(now())

  @@index([iso, createdAt])
}

model PurchaseInvoice {
  id           String             @id @default(uuid())
  number       String
  providerName String
  incoterm     String
  logistics    String
  amount       Decimal            @db.Decimal(12, 2)
  extras       Json
  demo         Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        PurchaseInvoiceLine[]
  containers   Container[]
  pendingExtras PendingExtraCost[]
  documents    PurchaseDocument[]

  @@index([number])
  @@index([demo])
}

model PurchaseDocument {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  kind              String
  originalName      String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  createdAt         DateTime        @default(now())

  @@index([purchaseInvoiceId])
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  invoiceId         String
  invoice           PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  iso               String
  type              String
  cat               String
  year              Int?
  manufacturer      String          @default("—")
  price             Decimal         @db.Decimal(12, 2)
  bl                String          @default("")
  manifest          String          @default("")
  isoException      Boolean         @default(false)
}

model PendingExtraCost {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  serviceKey        String
  serviceLabel      String
  suggestedProvider String          @default("")
  isos              String[]
  status            String          @default("pending")
  createdAt         DateTime        @default(now())

  @@index([status])
}

model ContainerType {
  code       String    @id
  label      String
  dims       String
  color      String
  protected  Boolean   @default(false)
  archivedAt DateTime?
}

model Category {
  code       String    @id
  label      String
  color      String
  protected  Boolean   @default(false)
  archivedAt DateTime?
}

model Customer {
  id               String      @id @default(uuid())
  rucDni           String
  companyName      String
  email            String
  phone            String
  risk             RiskGrade   @default(B)
  demo             Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  ownedContainers  Container[] @relation("OwnedContainers")
  users            User[]
  quotes           Quote[]

  @@index([demo])
}

model InspectionPhoto {
  id             String    @id @default(uuid())
  iso            String
  container      Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  slot           Int
  storageKey     String
  publicKey      String?
  mimeType       String
  originalName   String
  sizeBytes      Int
  status         String    @default("activa")
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedByName String?
  rejectNote     String?
  createdAt      DateTime  @default(now())

  @@index([iso, status])
  @@index([iso, slot])
}

model ContainerPosition {
  id        String    @id @default(uuid())
  iso       String
  container Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  depotId   String
  lado      String
  ruma      Int
  columna   Int
  nivel     Int
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([iso, createdAt])
}

model AppSetting {
  key   String @id
  value Json
}

model Provider {
  id        String   @id @default(uuid())
  name      String
  type      String
  rate      Decimal  @db.Decimal(12, 2)
  unit      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model PricingRule {
  id             String   @id @default(uuid())
  scope          String
  target         String?
  marginPct      Decimal  @db.Decimal(6, 2)
  maxDiscountPct Decimal  @db.Decimal(6, 2)
  createdAt      DateTime @default(now())
}

model VisibilityRule {
  id        String   @id @default(uuid())
  scope     String
  target    String?
  show      Boolean
  createdAt DateTime @default(now())
}

model CommercialService {
  id    String  @id @default(uuid())
  name  String
  price Decimal @db.Decimal(12, 2)
}

model Quote {
  id                 String           @id @default(uuid())
  number             String           @unique
  kind               String           @default("venta")
  dealStatus         String           @default("nueva")
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  vendorId           String
  vendor             User             @relation("QuoteVendor", fields: [vendorId], references: [id])
  lostReason         String?
  holdExpiresAt      DateTime?
  holdPausedAt       DateTime?
  freightZoneId      String?
  freightVehicle     String?
  freightSnapshot    Json?
  movementInformed   Boolean          @default(false)
  movementWaived     Boolean          @default(false)
  clientPickup       Boolean          @default(false)
  dispatchDate       DateTime?
  dispatchDepotId    String?
  dispatchNotes      String?
  demo               Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lines              QuoteLine[]
  extras             QuoteExtra[]
  messages           DealMessage[]
  vouchers           PaymentVoucher[]
  events             QuoteEvent[]
  odooJobs           OdooSyncJob[]
  dispatches         Dispatch[]

  @@index([dealStatus])
  @@index([vendorId])
  @@index([customerId])
  @@index([demo])
}

model QuoteLine {
  id        String    @id @default(uuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  iso       String
  type      String
  cat       String
  listPrice Decimal   @db.Decimal(12, 2)
  minPrice  Decimal   @db.Decimal(12, 2)
  priceNet  Decimal   @db.Decimal(12, 2)
  frozenAt  DateTime?
}

model QuoteExtra {
  id       String  @id @default(uuid())
  quoteId  String
  quote    Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind     String
  label    String
  amount   Decimal @db.Decimal(12, 2)
  accepted Boolean @default(false)
  meta     Json?
}

model DealMessage {
  id         String   @id @default(uuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorRole String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([quoteId, createdAt])
}

model PaymentVoucher {
  id               String   @id @default(uuid())
  quoteId          String
  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  storageKey       String
  mimeType         String
  originalName     String
  sizeBytes        Int
  bank             String   @default("")
  operationNumber  String   @default("")
  paidAt           DateTime?
  declaredAmount   Decimal  @db.Decimal(12, 2)
  status           String   @default("subido")
  reviewNote       String?
  createdAt        DateTime @default(now())

  @@index([quoteId, status])
}

model QuoteEvent {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type      String
  detail    String
  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
}

model OdooSyncJob {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  event     String
  payload   Json
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Dispatch {
  id            String    @id @default(uuid())
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  reason        String    @default("venta")
  status        String    @default("Pendiente de programar")
  depotId       String?
  scheduledDate DateTime?
  notes         String    @default("")
  isos          String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model OdooLotCandidate {
  id             String    @id @default(uuid())
  odooLotId      Int       @unique
  odooWriteDate  DateTime?
  serialRaw      String
  isoNormalized  String
  iso6346Ok      Boolean   @default(false)
  productName    String    @default("")
  productCode    String    @default("")
  locationName   String    @default("")
  locationOdooId Int?
  qtyOnHand      Float     @default(0)
  color          String?
  tareKg         Int?
  mgwKg          Int?
  year           Int?
  manufacturer   String?
  dua            String?
  odooPoName     String?
  odooPoId       Int?
  odooVendorName String?
  odooBillName   String?
  odooUnitPrice  Decimal?  @db.Decimal(12, 2)
  originCountry  String?
  material       String?
  zgroupCode     String?
  zdryType       String?
  zdryCat        String?
  zdryNotes      String    @default("")
  localTouched   Boolean   @default(false)
  odooSyncStatus String    @default("live")
  odooSyncError  String?
  payload        Json?
  status         String    @default("pending")
  containerIso   String?
  lastSyncedAt   DateTime  @default(now())
  assimilatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  writebacks     OdooFieldWriteback[]

  @@index([isoNormalized])
  @@index([status])
  @@index([lastSyncedAt])
  @@index([odooSyncStatus])
}

model OdooFieldWriteback {
  id          String           @id @default(uuid())
  candidateId String
  candidate   OdooLotCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  field       String
  value       Json
  status      String           @default("pending")
  attempts    Int              @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([candidateId, status])
  @@index([status])
}

model FieldCapture {
  id             String    @id @default(uuid())
  iso            String
  container      Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  kind           String
  storageKey     String
  mimeType       String
  originalName   String
  sizeBytes      Int
  note           String    @default("")
  assignedSlot   Int?
  createdById    String?
  createdByName  String
  createdAt      DateTime  @default(now())

  @@index([iso, createdAt])
}

model DepotCostConcept {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  system    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   DepotCostEntry[]
}

model DepotCostEntry {
  id           String           @id @default(uuid())
  iso          String
  container    Container        @relation(fields: [iso], references: [iso], onDelete: Cascade)
  conceptId    String
  concept      DepotCostConcept @relation(fields: [conceptId], references: [id])
  conceptKey   String
  conceptLabel String
  amount       Decimal          @db.Decimal(12, 2)
  note         String           @default("")
  auto         Boolean          @default(false)
  createdById  String?
  createdByName String
  createdAt    DateTime         @default(now())

  @@index([iso, createdAt])
  @@index([iso, conceptKey])
}

model ContainerDocument {
  id            String    @id @default(uuid())
  iso           String
  container     Container @relation(fields: [iso], references: [iso], onDelete: Cascade)
  concept       String
  note          String    @default("")
  originalName  String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  createdById   String?
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([iso, createdAt])
}

model GateVisit {
  id            String     @id @default(uuid())
  tractorPlate  String
  company       String     @default("")
  ruc           String     @default("")
  driverName    String     @default("")
  visitAt       DateTime?
  license       String     @default("")
  motive        String     @default("descargar")
  trailerPlate  String     @default("")
  phone         String     @default("")
  equipmentCode String?
  containerIso  String?
  container     Container? @relation(fields: [containerIso], references: [iso])
  linkedAt      DateTime?
  linkedByName  String?
  unitPhotoKey          String?
  unitPhotoMime         String?
  unitPhotoName         String?
  unitPhotoApprovedAt   DateTime?
  unitPhotoApprovedBy   String?
  unitPhotoRejectedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tractorPlate])
  @@index([containerIso])
  @@index([linkedAt])
}

model DataBackup {
  id         String   @id @default(uuid())
  label      String
  kind       String
  storageKey String
  sizeBytes  Int
  createdBy  String?
  notes      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
